# Reverse-proxy TLS de production — certificats Let's Encrypt automatiques.

abidjan4all.info {
	reverse_proxy web:3000
	encode gzip

	# Journal d'accès — sert à connaître les navigateurs réellement utilisés
	# par le lectorat (décision de compatibilité : voir les vieux Safari).
	# Les adresses IP et les en-têtes d'authentification sont SUPPRIMÉS : on
	# n'a besoin que du navigateur, et le site est soumis au RGPD.
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 3
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Set-Cookie delete
			}
		}
	}
}

www.abidjan4all.info {
	redir https://abidjan4all.info{uri} permanent
}

# ---------------------------------------------------------------------------
# Ancien domaine — abidjan4all.net
#
# Le site d'origine a vécu des années sur ce nom : des milliers de liens, de
# partages WhatsApp et de pages indexées y mènent encore. Tant qu'il répondait
# sur son ancien hébergement, les deux sites se concurrençaient sur les mêmes
# contenus, et le crédit accumulé par le .net ne profitait pas au .info.
#
# Chaque adresse est donc renvoyée vers le MÊME chemin sur abidjan4all.info,
# en 301. L'application prend le relais : elle consulte les règles du Studio
# (3 146 chargées pour la bascule), et à défaut renvoie les adresses en .html
# vers l'accueil. Deux sauts au total, que les moteurs suivent sans perte.
#
# PRÉALABLE OBLIGATOIRE : les enregistrements A de `abidjan4all.net` et de
# `www.abidjan4all.net` doivent déjà pointer vers ce serveur. Caddy réclame un
# certificat dès qu'un nom apparaît ici, et Let's Encrypt plafonne les échecs
# à cinq par heure et par nom : déployer avant la bascule DNS consommerait le
# quota avant même qu'elle soit faite.
#
#   dig +short abidjan4all.net @1.1.1.1      → doit répondre 31.70.137.228
#   dig +short www.abidjan4all.net @1.1.1.1  → idem
#
abidjan4all.net, www.abidjan4all.net {
	redir https://abidjan4all.info{uri} permanent
}

# L'accès direct par IP servait TOUT le site en HTTP clair, page de connexion
# et Studio compris : identifiants et cookie de session voyageaient en clair
# pour qui empruntait cette adresse. Un confort de recette payé d'une fuite
# permanente de crédentiels — supprimé.
#
# Pour atteindre l'application sans passer par le domaine (débogage), ouvrir un
# tunnel plutôt qu'un port :
#   ssh -L 3000:localhost:3000 root@31.70.137.228
# puis http://localhost:3000 sur son poste. Rien ne transite en clair sur le
# réseau, l'accès reste réservé à qui détient déjà la clé SSH.

# ---------------------------------------------------------------------------
# Activepieces — automation.abidjan4all.info
#
# Bloc ACTIF : le sous-domaine résout vers ce serveur et le certificat est
# délivré.
#
# Il est resté commenté jusqu'à la bascule du DNS, et ce n'était pas de la
# prudence de principe : Caddy réclame un certificat dès qu'un nom apparaît
# ici. Tant que ce nom résolvait ailleurs, la validation échouait — et Let's
# Encrypt plafonne les échecs à cinq par heure et par nom. Le quota serait
# parti avant même que le DNS soit corrigé.
#
# La même précaution vaut pour tout sous-domaine ajouté ensuite : on écrit son
# bloc en commentaire, on bascule le DNS, on décommente, puis on recharge.
#
# Rechargement sans redémarrage, après une modification faite SUR PLACE dans ce
# fichier (éditeur sur le serveur) :
#   cd /root/abidjan4all && docker compose -f infra/docker/docker-compose.prod.yml --env-file .env exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# APRÈS UN `git pull`, le rechargement ne suffit pas — il faut recréer le
# conteneur :
#   cd /root/abidjan4all && docker compose -f infra/docker/docker-compose.prod.yml --env-file .env up -d --force-recreate caddy
#
# Ce fichier est monté un à un (`./Caddyfile:/etc/caddy/Caddyfile`), et Docker
# attache le montage au FICHIER, pas à son chemin. Or git ne modifie pas un
# fichier : il le remplace. Le conteneur reste donc accroché à l'ancien, devenu
# invisible, et `caddy reload` relit fidèlement la version d'avant en
# annonçant « config is unchanged ». Vérification quand le doute s'installe :
#   docker compose … exec caddy grep -c "le_nom_ajouté" /etc/caddy/Caddyfile
# Une réponse à 0 alors que le fichier du dépôt le contient signe ce cas.
#
# `activepieces-app` est joignable parce que le conteneur Caddy a été rattaché
# au réseau d'Activepieces. Le port 80 visé est celui de l'application DANS son
# conteneur ; il reste invisible depuis l'internet, seul Caddy y accède.
#
automation.abidjan4all.info {
	# Inscription libre fermee.
	#
	# Cette edition d'Activepieces n'a pas d'interrupteur pour cela : la seule
	# bride prevue est la restriction par domaine de courriel, inutilisable ici
	# puisque les comptes proprietaires sont sur gmail.com — autoriser ce
	# domaine reviendrait a n'autoriser personne, ou tout le monde. On barre
	# donc la route au niveau du proxy, qui est de toute facon le seul chemin
	# vers l'application.
	#
	# La CONNEXION reste intacte : seule la creation de compte est refusee.
	#
	# A savoir : si vous invitez un jour un collaborateur, l'acceptation de son
	# invitation passe elle aussi par cette route. Il faudra la rouvrir le temps
	# qu'il cree son compte — commenter les deux lignes ci-dessous, redemarrer
	# caddy, puis les retablir.
	@inscription path /api/v1/authentication/sign-up
	respond @inscription "Inscription fermee sur cette instance." 403

	# La page d'inscription elle-meme renvoie vers la connexion, pour ne pas
	# presenter un formulaire qui ne peut plus aboutir.
	@page_inscription path /sign-up
	redir @page_inscription /sign-in

	reverse_proxy activepieces-app:80
	encode gzip
}
