# Base de données (PostgreSQL 15)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abidjan4all?schema=public

# Cache / files
REDIS_URL=redis://localhost:6379

# Auth.js (NextAuth v5) — `npx auth secret` ou openssl rand -base64 32
AUTH_SECRET=

# Média — S3-compatible (IONOS Object Storage)
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=

# Paiements — PayDunya (MoMo/Orange/carte) + international
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# IA (résumé, recherche générative, chatbot, modération)
AI_API_KEY=
AI_MODEL=

# SEO / analytics (DF-06)
NEXT_PUBLIC_SITE_URL=https://abidjan4all.net
NEXT_PUBLIC_GA4_ID=
