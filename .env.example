# Base de données (PostgreSQL 15)
# En compose de prod, l'hôte est le service : postgresql://postgres:...@postgres:5432/abidjan4all
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abidjan4all?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=abidjan4all

# Cache / files
REDIS_URL=redis://localhost:6379

# Auth.js (NextAuth v5) — `npx auth secret` ou openssl rand -base64 32
AUTH_SECRET=

# Média — S3-compatible (IONOS Object Storage)
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=

# Paiements — PayDunya (MoMo/Orange/carte) + international
# Secret HMAC des webhooks (openssl rand -hex 32) — sans lui, signature non vérifiée (dev)
PAYMENTS_WEBHOOK_SECRET=
# Prestataire actif : mock (défaut, dev) ou paydunya (production)
PAYMENT_PROVIDER=mock
# PAYDUNYA_MODE=test → sandbox-api (clés test_) ; live par défaut
PAYDUNYA_MODE=
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# Stripe (carte/PayPal diaspora) : dès que la clé est là, carte/PayPal y sont routés
STRIPE_SECRET_KEY=
# Secret de signature du endpoint webhook (whsec_…, tableau de bord Stripe)
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# IA (résumé, recherche générative, chatbot, modération)
AI_API_KEY=
AI_MODEL=

# SEO / analytics (DF-06)
NEXT_PUBLIC_SITE_URL=https://abidjan4all.net
NEXT_PUBLIC_GA4_ID=

# E-mails transactionnels (SMTP — ex. IONOS). Sans ces variables, aucun envoi.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web Push VAPID (DF-04) — générer : npx web-push generate-vapid-keys
# Sans clés, les alertes push sont simplement désactivées.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@abidjan4all.net
