// Schéma Prisma — Abidjan4All
// Source : design_handoff_abidjan4all/DATA_MODEL.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  reader
  member
  journalist
  editor
  admin
  partner
  ad_manager // Gestionnaire Régie : accès Studio limité à la régie publicitaire
}

enum ArticleStatus {
  draft
  review
  scheduled
  published
}

enum RubriqueKind {
  gratuit
  freemium
  premium
  affiliation
}

enum MediaType {
  image
  video
  svg
  audio
}

// DATA_MODEL.md laisse le statut du live-blog non typé ; valeurs déduites du
// prototype Live Blog.dc.html (à faire évoluer si le CdC en précise d'autres).
enum LiveBlogStatus {
  scheduled
  live
  ended
}

enum LiveUpdateType {
  text
  quote
  stat
  media
}

enum CommentStatus {
  pending
  approved
  rejected
  flagged
}

enum Plan {
  free
  essentiel
  diaspora // A4A+ Diaspora (Business Model 2026-2031, pilier 3)
  pro
  corporate
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}

enum PaymentMethod {
  momo
  orange
  wave
  moov
  djamo
  card
  paypal
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum AdFormat {
  leaderboard_728x90
  mpu_300x250
  native
  interstitial
  skin // habillage : fond de page cliquable
  video // encart sponsor sur la page Vidéos
}

enum AdStatus {
  draft
  pending_review // réservation self-service payée, en attente de validation avant diffusion
  active
  paused
  ended
}

enum AdPriority {
  basse
  moyenne
  haute
}

enum ListingType {
  emploi
  immobilier
  service
}

enum ListingStatus {
  pending
  published
  expired
}

enum OrderKind {
  listing_emploi
  listing_immobilier
  whatsapp
  ad_reservation
  brief_abonnement // abonnement A4A Intelligence (pilier B2B)
  event_ticket // billet d'événement A4A (pilier événementiel)
  recruteur // accès recruteur à la CVthèque (pilier marketplace)
  course_enrollment // inscription payante à un cours A4A Academy (pilier formation)
}

enum OrderStatus {
  pending
  paid
  failed
}

enum FactCheckVerdict {
  vrai
  faux
  trompeur
  a_verifier
}

// ---------------------------------------------------------------------------
// Utilisateurs & communauté
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         Role     @default(reader)
  avatarUrl    String?
  country      String? // ex. "CI", "CA"
  bio          String?
  verified     Boolean  @default(false) // badge « compte vérifié » (éditorial)
  /// Date de validation de l'adresse e-mail. NULL = inscription libre non
  /// confirmée : la connexion est refusée tant que le lien n'est pas cliqué.
  /// Les comptes créés par l'administration sont validés d'office.
  emailVerified DateTime?
  badges       Badge[]
  interests    String[] // ids de rubriques (feed "Pour vous")
  locale       String   @default("fr") // fr | en
  theme        String   @default("light")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscription            Subscription?
  cvProfile               CvProfile?
  orders                  Order[]
  whatsappMembership      WhatsappMembership?
  briefAbonnements        BriefAbonnement[]
  eventRegistrations      EventRegistration[]
  recruiterAccess         RecruiterAccess?
  advertiserCampaigns     AdCampaign[]             @relation("AdvertiserCampaigns")
  comments                Comment[]
  favorites               Article[]                @relation("Favorites")
  groups                  Group[]
  articles                Article[]                @relation("AuthoredArticles")
  coauthoredArticles      Article[]                @relation("CoauthoredArticles")
  mediaAssets             MediaAsset[]
  listings                Listing[]
  enrollments             Enrollment[]
  newsletterSubscriptions NewsletterSubscription[]
  pushSubscriptions       PushSubscription[]
  passwordSetTokens       PasswordSetToken[]
  emailVerificationTokens EmailVerificationToken[]
  apiTokens               ApiToken[]
  oauthCodes              OAuthCode[]
  accounts                Account[]
}

/// Jeton de confirmation d'adresse e-mail (inscription libre), usage unique.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Jeton à usage unique pour définir/réinitialiser son mot de passe
/// (invitation envoyée par e-mail à la création d'un compte).
model PasswordSetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

/// Compte tiers (Google, Facebook, Apple) rattaché à un compte Abidjan4All.
///
/// L'identité que nous conservons est `providerAccountId` — l'identifiant
/// stable donné par le fournisseur — et non l'adresse e-mail : une adresse peut
/// changer de mains, pas cet identifiant. Une fois le lien créé, les connexions
/// suivantes passent par lui et ne redemandent aucune vérification d'e-mail.
model Account {
  id       String @id @default(cuid())
  /// « google », « facebook », « apple ».
  provider String
  /// Identifiant du compte chez le fournisseur (le « sub » du jeton).
  providerAccountId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Jeton d'accès à l'API (/api/v1) et au connecteur MCP (/api/mcp). Permet à un
/// outil externe — l'application Claude, un script de la rédaction — d'agir au
/// nom d'un compte du Studio sans jamais partager son mot de passe.
///
/// Le secret n'est PAS stocké : seule son empreinte SHA-256 l'est, si bien
/// qu'une copie de la base ne livre aucun jeton utilisable. Il n'est affiché
/// qu'une fois, à la création. `prefix` est le début du jeton, gardé en clair
/// pour que l'administrateur reconnaisse la ligne qu'il veut révoquer.
model ApiToken {
  id     String @id @default(cuid())
  /// Libellé donné par l'administrateur (« Claude Desktop de Georges »).
  name   String
  /// Début lisible du jeton, ex. « a4a_7f3c9b21 ».
  prefix String @unique
  /// SHA-256 du jeton complet, en hexadécimal.
  tokenHash String @unique

  /// Portées accordées : articles:read, articles:write, stats:read. Le rôle du
  /// compte porteur reste le plafond — un jeton ne donne jamais plus de droits
  /// que son propriétaire n'en a dans le Studio.
  scopes String[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// Renseigné quand le jeton a été délivré par le flux OAuth plutôt que créé
  /// à la main dans le Studio : permet d'afficher « émis pour Claude » et de
  /// tout révoquer d'un coup si l'application est débranchée.
  oauthClient   OAuthClient? @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  oauthClientId String?

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Application cliente OAuth, enregistrée dynamiquement (RFC 7591). C'est ainsi
/// que l'application Claude se déclare : elle appelle /oauth/register, obtient
/// un client_id, puis lance le flux d'autorisation.
///
/// S'enregistrer ne donne aucun droit : tant qu'un membre de la rédaction n'a
/// pas ouvert l'écran d'autorisation et cliqué « Autoriser », aucun jeton
/// n'existe. L'enregistrement n'est qu'une déclaration d'identité.
model OAuthClient {
  id       String @id @default(cuid())
  clientId String @unique
  /// SHA-256 du secret, pour les clients confidentiels. NULL pour les clients
  /// publics (application de bureau), qui s'appuient sur PKCE.
  clientSecretHash String?
  name             String
  /// Adresses de retour autorisées. La comparaison est stricte : une URL de
  /// retour non enregistrée fait échouer l'autorisation.
  redirectUris String[]
  createdAt    DateTime @default(now())

  codes  OAuthCode[]
  tokens ApiToken[]
}

/// Code d'autorisation à usage unique (RFC 6749 §4.1) protégé par PKCE.
/// Le code n'est pas stocké en clair : seule son empreinte SHA-256 l'est, comme
/// pour les jetons. Durée de vie courte, une seule utilisation.
model OAuthCode {
  id       String @id @default(cuid())
  codeHash String @unique

  client        OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  oauthClientId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// Rappelés ici pour être revérifiés à l'échange : un code volé ne sert à
  /// rien s'il est présenté depuis une autre adresse de retour.
  redirectUri   String
  scopes        String[]
  codeChallenge String
  method        String   @default("S256")

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([oauthClientId])
}

/// Abonnement Web Push (VAPID) — anonyme ou rattaché à un compte pour
/// filtrer les alertes par intérêts rubrique (DF-04).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  createdAt DateTime @default(now())
}

model Badge {
  id    String @id @default(cuid())
  slug  String @unique // diaspora, expert_cacao, journalist, ambassadeur...
  label String
  users User[]
}

model Group {
  id           String @id @default(cuid())
  slug         String @unique
  name         String
  color        String
  membersCount Int    @default(0)
  members      User[]
}

// ---------------------------------------------------------------------------
// Pages statiques (À propos, Mentions légales, Contact, CGU, Confidentialité)
// ---------------------------------------------------------------------------

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String // HTML nettoyé (éditeur enrichi)
  published Boolean  @default(true)
  inFooter  Boolean  @default(true)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Redirection 301 gérée depuis le Studio (migration d'anciennes URLs).
/// Les redirections structurelles de l'ancien site restent dans next.config.
model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique // chemin source, ex. "/ancienne-page.html"
  to        String // destination, chemin interne ou URL absolue
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

/// Une page vue. Base des statistiques d'audience du Studio.
///
/// RGPD : aucune adresse IP n'est stockée. `visitorHash` est une empreinte
/// (IP + navigateur + sel du jour) : elle permet de distinguer les visiteurs
/// SANS pouvoir remonter à quelqu'un, et devient inexploitable le lendemain
/// puisque le sel change. Aucun cookie n'est posé — la mesure fonctionne donc
/// pour tous les lecteurs, y compris ceux qui refusent le bandeau.
model PageView {
  id          String   @id @default(cuid())
  path        String
  /// article | video | podcast | rubrique | autre — pour les compteurs métier.
  kind        String   @default("autre")
  /// Empreinte anonyme du visiteur, valable une journée (voir lib/audience.ts).
  visitorHash String
  /// Regroupe les pages vues d'une même venue (30 min d'inactivité = nouvelle).
  sessionId   String
  /// mobile | desktop — déduit du navigateur annoncé.
  device      String   @default("desktop")
  /// Code pays ISO (CI, FR…), déduit de l'IP à la volée puis l'IP est jetée.
  country     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([visitorHash, createdAt])
  @@index([sessionId])
  @@index([kind, createdAt])
}

/// Vidéo diffusée sur le site (rubrique « Vidéos »), gérée depuis le Studio.
/// L'hébergement est délégué à la plateforme (YouTube/Facebook/Vimeo/Dailymotion) :
/// le VPS ne sait ni stocker ni encoder de la vidéo, et le direct exigerait un
/// serveur de streaming. On ne stocke donc qu'une URL, dont l'identifiant est
/// extrait côté serveur — jamais de code d'intégration collé (faille XSS).
model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  /// URL publique d'origine, telle que saisie par la rédaction.
  sourceUrl   String
  /// Plateforme reconnue : youtube | facebook | vimeo | dailymotion.
  provider    String
  /// Identifiant extrait de l'URL — sert à construire l'URL d'intégration.
  providerRef String
  /// Direct/streaming en cours : mis en avant et badgé « EN DIRECT ».
  live        Boolean  @default(false)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

/// Entrée du menu principal, gérée depuis le Studio.
/// Si la table est vide, l'en-tête retombe sur le menu par défaut du code :
/// une mauvaise manipulation ne peut donc pas laisser le site sans navigation.
model MenuItem {
  id      String  @id @default(cuid())
  label   String
  href    String // chemin interne ("/politique") ou URL absolue
  order   Int     @default(0)
  visible Boolean @default(true)
}

/// Message envoyé via le formulaire de contact public — reçu dans le Studio.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Éditorial
// ---------------------------------------------------------------------------

model Rubrique {
  id    String       @id @default(cuid())
  slug  String       @unique // "cacao-marches"
  name  String
  color String // "#8A5A2B"
  kind  RubriqueKind
  order Int

  articles  Article[]
  liveBlogs LiveBlog[]
}

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  kicker      String?
  dek         String? // chapeau
  body        Json // blocs WYSIWYG : paragraph, h2, quote, image, embed, callout
  status      ArticleStatus @default(draft)
  premium     Boolean       @default(false)
  publishedAt DateTime?
  scheduledAt DateTime?

  rubrique   Rubrique @relation(fields: [rubriqueId], references: [id])
  rubriqueId String

  author   User   @relation("AuthoredArticles", fields: [authorId], references: [id])
  authorId String

  coauthors User[] @relation("CoauthoredArticles")

  coverAsset   MediaAsset? @relation("ArticleCover", fields: [coverAssetId], references: [id])
  coverAssetId String?

  tags         String[]
  readingTime  Int      @default(0)
  views        Int      @default(0)
  featuredRank Int? // position à la Une (1 à 5) — null = pas en Une
  hidden       Boolean  @default(false) // publié mais masqué du public (éditeur/admin)
  seo         Json     @default("{}") // { slug, metaTitle, metaDescription, ogImage }
  aiSummary   Json? // { keyPoints: string[], long: string }

  // Native advertising : article sponsorisé signalé « Communiqué partenaire ».
  sponsored   Boolean @default(false)
  sponsorName String? // annonceur affiché sous le label (ex. « Orange CI »)

  comments    Comment[]
  favoritedBy User[]      @relation("Favorites")
  liveBlog    LiveBlog?
  factChecks  FactCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // colonne générée (migration fulltext_search) : to_tsvector('french', titre+chapeau+corps),
  // index GIN — interrogée via $queryRaw (websearch_to_tsquery), cf. apps/web/lib/search.ts
  searchVector Unsupported("tsvector")?

  @@index([status, publishedAt])
  @@index([rubriqueId, publishedAt])
}

model MediaAsset {
  id          String    @id @default(cuid())
  type        MediaType
  url         String
  thumbUrl    String?
  width       Int?
  height      Int?
  durationSec Int?
  sizeBytes   Int?
  tags        String[]
  alt         String?
  credit      String?

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String

  articlesAsCover Article[]    @relation("ArticleCover")
  liveUpdates     LiveUpdate[]

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Live-blog (temps réel : SSE/WebSocket /liveblogs/:id/stream)
// ---------------------------------------------------------------------------

model LiveBlog {
  id String @id @default(cuid())

  article   Article? @relation(fields: [articleId], references: [id])
  articleId String?  @unique

  title String
  dek   String?

  rubrique   Rubrique @relation(fields: [rubriqueId], references: [id])
  rubriqueId String

  status       LiveBlogStatus @default(live)
  startedAt    DateTime       @default(now())
  updatesCount Int            @default(0)

  updates LiveUpdate[]
}

model LiveUpdate {
  id String @id @default(cuid())

  liveBlog   LiveBlog @relation(fields: [liveBlogId], references: [id])
  liveBlogId String

  time   DateTime       @default(now())
  type   LiveUpdateType
  title  String?
  body   String
  pinned Boolean        @default(false)

  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  mediaAssetId String?

  @@index([liveBlogId, time])
}

// ---------------------------------------------------------------------------
// Commentaires (modération : file d'attente + score de toxicité IA)
// ---------------------------------------------------------------------------

model Comment {
  id String @id @default(cuid())

  article   Article @relation(fields: [articleId], references: [id])
  articleId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  body      String
  status    CommentStatus @default(pending)
  reactions Json          @default("{}") // { "👍": 24, "🔥": 6 }

  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  parentId String?
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())

  @@index([articleId, status])
}

// ---------------------------------------------------------------------------
// Abonnements & paiements (A4A+ : Essentiel 2 000 XOF/mois · Pro 4 000 · Corporate sur devis)
// ---------------------------------------------------------------------------

model Subscription {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  plan             Plan               @default(free)
  status           SubscriptionStatus @default(active)
  method           PaymentMethod?
  methodMask       String? // ex. "07 •• •• 89", "•••• 4242"
  currentPeriodEnd DateTime?
  since            DateTime           @default(now())

  payments Payment[]
}

model Payment {
  id String @id @default(cuid())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId String

  amount      Int
  currency    String        @default("XOF")
  provider    String // paydunya | cinetpay | stripe | paypal
  providerRef String
  status      PaymentStatus @default(pending)
  createdAt   DateTime      @default(now())

  invoice Invoice?
}

model Invoice {
  id String @id @default(cuid())

  payment   Payment @relation(fields: [paymentId], references: [id])
  paymentId String  @unique

  number   String   @unique
  url      String
  issuedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Newsletters (double opt-in)
// ---------------------------------------------------------------------------

model Newsletter {
  id               String @id @default(cuid())
  slug             String @unique
  name             String
  cadence          String // quotidienne | hebdo | mensuelle...
  description      String
  subscribersCount Int    @default(0)

  subscriptions NewsletterSubscription[]
  editions      NewsletterEdition[]
}

/// Une édition composée et envoyée d'une newsletter (archive + statut).
model NewsletterEdition {
  id           String   @id @default(cuid())
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  newsletterId String
  subject      String
  introHtml    String   @default("") // texte d'intro (éditeur enrichi, nettoyé)
  articleIds   Json     @default("[]") // articles inclus, dans l'ordre
  status       String   @default("draft") // draft | sent
  /// Destinataires choisis à la main (adresses). Vide = tous les inscrits
  /// confirmés de cette newsletter — comportement d'origine préservé.
  recipientEmails Json  @default("[]")
  /// Segments d'audience visés (ci, diaspora, afrique, business).
  /// Vide = tous les segments — comportement d'origine préservé.
  segments        Json  @default("[]")
  recipientCount Int    @default(0)
  /// Sponsor exclusif de l'envoi (Business Model 2026-2031 : 600 000 FCFA
  /// l'envoi). Vide = aucun encart sponsor dans le message.
  sponsorName     String?
  sponsorBaseline String?
  sponsorLogoUrl  String?
  sponsorLinkUrl  String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NewsletterSubscription {
  id String @id @default(cuid())

  newsletter   Newsletter @relation(fields: [newsletterId], references: [id])
  newsletterId String

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  email     String
  confirmed Boolean  @default(false)
  /// Centres d'intérêt choisis à l'inscription (ci, diaspora, afrique,
  /// business). Vide = reçoit tout, quel que soit le ciblage d'une édition.
  segments  String[] @default([])
  createdAt DateTime @default(now())

  @@unique([newsletterId, email])
}

// ---------------------------------------------------------------------------
// Régie publicitaire
// ---------------------------------------------------------------------------

/// Campagne = conteneur d'un annonceur. Elle regroupe une ou plusieurs
/// bannières (créatifs) qui tournent selon la priorité, et porte le ciblage,
/// la période et les plafonds de diffusion partagés.
model AdCampaign {
  id         String     @id @default(cuid())
  advertiser String
  cpm        Int
  targeting  Json // { geo:["CI","FR","CEDEAO"], rubriques:[], device:"mobile" }
  priority   AdPriority @default(moyenne) // pondère le tirage entre campagnes

  startAt   DateTime
  endAt     DateTime
  permanent Boolean @default(false) // diffusion permanente : ignore endAt

  // Plafonds de diffusion (null = illimité) — la campagne s'arrête d'elle-même
  // quand le total cumulé des bannières atteint le plafond.
  capImpressions Int?
  capClicks      Int?

  status    AdStatus @default(draft)
  createdAt DateTime @default(now())

  // Compte annonceur (rôle « partner ») autorisé à consulter les stats de
  // cette campagne depuis son espace. Optionnel — assigné par l'administration.
  advertiserUser   User?   @relation("AdvertiserCampaigns", fields: [advertiserUserId], references: [id], onDelete: SetNull)
  advertiserUserId String?

  banners      AdBanner[]
  reservations Order[]    @relation("ReservationCampaign")

  @@index([advertiserUserId])
}

/// Journal des rapports mensuels envoyés (dédoublonnage : un envoi par
/// annonceur et par mois, quels que soient les redémarrages).
model AdReportLog {
  id               String   @id @default(cuid())
  advertiserUserId String
  period           String // "2026-07"
  // Compteurs cumulés au moment de l'envoi : le rapport du mois suivant
  // présente le delta par rapport à ce relevé.
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  sentAt           DateTime @default(now())

  @@unique([advertiserUserId, period])
}

/// Créatif d'une campagne : un visuel (ou une accroche) d'un format donné,
/// avec ses propres compteurs d'affichages et de clics.
model AdBanner {
  id         String     @id @default(cuid())
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String

  format   AdFormat
  headline String? // accroche affichée dans l'encart
  linkUrl  String? // destination du clic (comptée par /api/v1/ads/click/:id)
  imageUrl String? // visuel (servi par /uploads/:name)
  active   Boolean @default(true)

  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([campaignId])
}

/// Emplacement publicitaire (encart d'une page). Le catalogue des emplacements
/// est défini en code (lib/ad-placements.ts) ; cette table ne stocke que l'état
/// activé/désactivé piloté depuis la régie Studio. Une absence de ligne = état
/// par défaut du catalogue.
model AdPlacement {
  slug      String   @id // ex. "home_leaderboard"
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Pack de réservation self-service : grille des prix éditable au Studio
/// (/admin/ads/tarifs). Seedée depuis lib/tarifs.ts (PACKS_PUB), qui reste le
/// repli si la table est vide. Order.tier référence l'id — un pack retiré de
/// la vente passe `actif=false` plutôt que d'être supprimé s'il a des commandes.
model AdPack {
  id          String   @id // slug stable, ex. "bandeau-7"
  format      AdFormat
  label       String
  jours       Int
  prix        Int // FCFA
  description String
  ordre       Int      @default(0)
  actif       Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Marketplace (emploi / immobilier / service)
// ---------------------------------------------------------------------------

model Listing {
  id          String      @id @default(cuid())
  type        ListingType
  title       String
  description String
  price       Int?
  currency    String      @default("XOF")
  location    String
  attributes  Json // champs spécifiques par type

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  status   ListingStatus @default(pending)
  paidTier String?

  orders Order[]

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([type, status, expiresAt])
}

/// Commande one-off (hors abonnement) : dépôt d'annonce payant, adhésion
/// WhatsApp Club. Réutilise les mêmes prestataires que les abonnements mais
/// reste totalement séparée de Subscription/Payment/Invoice.
model Order {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  kind     OrderKind
  tier     String // identifiant du palier tarifaire (cf. lib/tarifs.ts)
  amount   Int
  currency String    @default("XOF")
  provider String // mock | paydunya | stripe…
  providerRef String @default("")
  status   OrderStatus @default(pending)

  // Cible : annonce à publier une fois payée (listing_*), sinon null (whatsapp).
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId String?

  // Réservation d'emplacement publicitaire : campagne à activer une fois payée.
  campaign   AdCampaign? @relation("ReservationCampaign", fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([providerRef])
  @@index([campaignId])
}

/// Adhésion au WhatsApp Club (accès au groupe privé), une par membre.
model WhatsappMembership {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  tier      String
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Accès recruteur à la CVthèque (pilier 5) : les coordonnées des candidats
/// ne sont visibles que d'un recruteur abonné en cours de validité.
model RecruiterAccess {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  tier      String
  expiresAt DateTime
  orderId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Lien d'affiliation traçable (pilier 8) : transferts d'argent, assurances,
/// partenaires. Le clic passe par /go/:code, qui compte puis redirige.
model AffiliateLink {
  id      String @id @default(cuid())
  code    String @unique
  partner String
  label   String
  url     String
  /// Commission annoncée par le partenaire (informative, pour le suivi).
  commission String?
  clicks  Int     @default(0)
  actif   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actif])
}

// ---------------------------------------------------------------------------
// Brand Content premium (pilier 2 du Business Model 2026-2031) : A4A Business
// Interview, A4A Inside, formats courts sponsorisés… Le catalogue est éditable
// au Studio ; les demandes des annonceurs alimentent un pipeline commercial.
// ---------------------------------------------------------------------------

enum BrandLeadStatus {
  nouveau
  en_cours
  gagne
  perdu
}

model BrandOffer {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  pitch       String
  description String
  /// Prix indicatif en FCFA (0 = sur devis).
  prix        Int
  /// Unité facturée (« l'interview », « l'article », « l'envoi »).
  unite       String
  /// Ce que le client reçoit, une ligne par élément.
  livrables   Json    @default("[]")
  actif       Boolean @default(true)
  ordre       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads BrandLead[]

  @@index([actif, ordre])
}

/// Demande d'un annonceur sur une offre de brand content.
model BrandLead {
  id      String      @id @default(cuid())
  offer   BrandOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  offerId String?

  societe String
  contact String
  email   String
  tel     String?
  message String

  status    BrandLeadStatus @default(nouveau)
  /// Note interne de la régie (suivi de la négociation).
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// A4A Événements — Forum Diaspora, A4A Awards, webinaires (pilier 7 du
// Business Model 2026-2031). Un ÉVÉNEMENT propose une ou plusieurs CATÉGORIES
// de billets ; chaque INSCRIPTION porte un code d'entrée unique. Les billets
// payants passent par le flux de commande commun.
// ---------------------------------------------------------------------------

enum EventKind {
  forum
  awards
  webinaire
  conference
}

enum EventStatus {
  draft
  published
  ended
  cancelled
}

enum RegistrationStatus {
  pending // billet payant : en attente du règlement
  confirmed
  cancelled
}

model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  kind        EventKind
  title       String
  pitch       String
  description String
  coverUrl    String?

  /// Événement en ligne (webinaire) : pas de lieu physique.
  enLigne Boolean @default(false)
  lieu    String?
  ville   String?

  startAt DateTime
  endAt   DateTime?

  /// Jauge totale, toutes catégories confondues (null = illimitée).
  capacite Int?

  /// Lien de connexion, révélé aux seuls inscrits confirmés.
  accessUrl String?

  status    EventStatus @default(draft)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tickets       EventTicket[]
  registrations EventRegistration[]
  sponsors      EventSponsor[]

  @@index([status, startAt])
}

/// Catégorie de billet (« Standard », « VIP », « Étudiant »). Prix 0 = gratuit.
model EventTicket {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  label       String
  description String
  prix        Int
  /// Places pour cette catégorie (null = seule la jauge de l'événement compte).
  quota       Int?
  ordre       Int     @default(0)
  actif       Boolean @default(true)

  registrations EventRegistration[]

  @@index([eventId, ordre])
}

model EventRegistration {
  id       String      @id @default(cuid())
  event    Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  ticket   EventTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  status RegistrationStatus @default(pending)
  /// Commande à l'origine de l'inscription (null = billet gratuit).
  orderId String?
  /// Code d'entrée présenté à l'accueil, unique sur tout le site.
  code    String             @unique

  createdAt DateTime @default(now())

  /// Une inscription par personne et par événement.
  @@unique([eventId, userId])
  @@index([ticketId])
}

/// Sponsor d'un événement (le sponsoring est un revenu du pilier 7).
model EventSponsor {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  name    String
  logoUrl String?
  linkUrl String?
  /// Niveau affiché (« Partenaire officiel », « Sponsor Gold »…).
  niveau  String
  ordre   Int     @default(0)

  @@index([eventId, ordre])
}

// ---------------------------------------------------------------------------
// A4A Intelligence — publications économiques B2B (pilier 4 du Business Model
// 2026-2031). Une SÉRIE est un produit d'abonnement annuel (« Rapport mensuel
// Cacao & Café ») ; ses ÉDITIONS sont les livraisons successives, dont le
// contenu intégral est réservé aux abonnés en cours de validité.
// ---------------------------------------------------------------------------

enum BriefKind {
  rapport // rapport périodique (mensuel Cacao & Café…)
  revue // revue trimestrielle (Investissements Afrique de l'Ouest…)
  classement // Top 100 Entreprises CI
  etude // étude sectorielle sur mesure
  revue_presse // revue de presse personnalisée corporate
}

model BriefSerie {
  id          String    @id @default(cuid())
  slug        String    @unique
  kind        BriefKind
  title       String
  /// Accroche commerciale affichée sur la vitrine /intelligence.
  pitch       String
  description String
  /// Public visé (« Traders, courtiers, exportateurs »).
  cible       String
  /// Prix de l'abonnement en FCFA, pour `dureeMois` mois de livraisons.
  prixAnnuel  Int
  dureeMois   Int       @default(12)
  /// Rythme annoncé (« mensuel », « trimestriel », « annuel »).
  rythme      String
  coverUrl    String?
  actif       Boolean   @default(true)
  ordre       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editions    BriefEdition[]
  abonnements BriefAbonnement[]

  @@index([actif, ordre])
}

model BriefEdition {
  id      String     @id @default(cuid())
  serie   BriefSerie @relation(fields: [serieId], references: [id], onDelete: Cascade)
  serieId String

  /// Repère de livraison, unique dans la série (« 2026-07 », « T3-2026 »).
  numero String
  title  String
  /// Résumé public (teaser) — visible de tous, y compris non-abonnés.
  resume String
  /// Corps réservé aux abonnés (blocs riches, même format que les articles).
  body   Json?
  /// PDF téléchargeable, réservé aux abonnés.
  fileUrl String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([serieId, numero])
  @@index([serieId, publishedAt])
}

/// Abonnement d'un compte à une série, pour une période donnée.
model BriefAbonnement {
  id      String     @id @default(cuid())
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  serie   BriefSerie @relation(fields: [serieId], references: [id], onDelete: Cascade)
  serieId String

  startAt   DateTime @default(now())
  expiresAt DateTime
  /// Commande à l'origine de l'abonnement (null = accès accordé par la régie).
  orderId   String?

  createdAt DateTime @default(now())

  @@unique([userId, serieId])
  @@index([serieId])
}

// ---------------------------------------------------------------------------
// E-learning
// ---------------------------------------------------------------------------

model Course {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  category     String
  level        String // débutant | intermédiaire | avancé
  price        Int
  isPremium    Boolean @default(false)
  lessonsCount Int     @default(0)
  rating       Float   @default(0)

  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id String @id @default(cuid())

  course   Course @relation(fields: [courseId], references: [id])
  courseId String

  order       Int
  title       String
  module      String
  videoUrl    String?
  durationSec Int
  resources   Json    @default("[]")

  lastForEnrollments Enrollment[] @relation("LastLesson")

  @@unique([courseId, order])
}

model Enrollment {
  id String @id @default(cuid())

  course   Course @relation(fields: [courseId], references: [id])
  courseId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  progressPct Int @default(0)

  lastLesson   Lesson? @relation("LastLesson", fields: [lastLessonId], references: [id])
  lastLessonId String?

  certificateIssued Boolean @default(false)

  @@unique([courseId, userId])
}

// ---------------------------------------------------------------------------
// Podcasts
// ---------------------------------------------------------------------------

model Podcast {
  id       String @id @default(cuid())
  slug     String @unique
  title    String
  category String
  cadence  String
  coverUrl String

  episodes Episode[]
}

model Episode {
  id String @id @default(cuid())

  podcast   Podcast @relation(fields: [podcastId], references: [id])
  podcastId String

  number      Int
  title       String
  description String
  audioUrl    String
  durationSec Int
  publishedAt DateTime

  @@unique([podcastId, number])
}

// ---------------------------------------------------------------------------
// Fact-checking & glossaire
// ---------------------------------------------------------------------------

model FactCheck {
  id      String           @id @default(cuid())
  claim   String
  verdict FactCheckVerdict
  topic   String
  body    String
  sources String[]

  article   Article? @relation(fields: [articleId], references: [id])
  articleId String?

  publishedAt DateTime @default(now())
}

model GlossaryTerm {
  id         String @id @default(cuid())
  term       String @unique
  category   String
  definition String
}

// ---------------------------------------------------------------------------
// E-commerce services : CV en ligne (gratuit)
// ---------------------------------------------------------------------------

/// CV en ligne d'un membre (bourse d'emploi). Gratuit, un par compte.
model CvProfile {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  headline    String // intitulé / métier recherché
  summary     String? // présentation libre
  phone       String?
  contactEmail String?
  location    String?
  skills      String[]
  experiences Json     @default("[]") // [{ role, company, period, detail }]
  education   Json     @default("[]") // [{ school, degree, year }]
  isPublic    Boolean  @default(true) // visible dans l'annuaire des CV

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
